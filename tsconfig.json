{
    "compilerOptions": {
        "module": "NodeNext",
        "target": "ES2020",
        "lib": ["ES2020", "ES2021.Intl", "DOM"],
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "strict": false,
        "outDir": "dist",
        "rootDir": "src"
    },
    "include": [
        "src/**/*.ts"
    ]
}
