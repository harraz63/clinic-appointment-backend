NODE_ENV=development
PORT=3000
DB_URI=postgres://postgres:postgres@postgres:5432/app_db
APP_NAME=Clinic Appointment Backend
APP_VERSION=1.0.0
SUPER_ADMIN_PHONE=01012345678
SUPER_ADMIN_PASSWORD=Admin@1234
JWT_PRIVATE_KEY=replace_me
REFRESH_TOKEN_PRIVATE_KEY=replace_me
CLINIC_CURRENCY=EGP
STORAGE_TYPE=local
APP_URL=http://localhost:3000

# S3 (required when STORAGE_TYPE=s3)
AWS_REGION=us-east-1
S3_BUCKET=my-bucket
S3_PUBLIC_URL=https://my-bucket.s3.us-east-1.amazonaws.com

# Cloudflare R2 (required when STORAGE_TYPE=r2)
CLOUDFLARE_BUCKET_NAME=my-r2-bucket
CLOUDFLARE_PUBLIC_DOMAIN=https://public.example.com
CLOUDFLARE_SECRET_ACCESS_KEY=replace_me
CLOUDFLARE_ACCOUNT_ID=replace_me
CLOUDFLARE_ACCESS_KEY_ID=replace_me

# Docker services
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
REDIS_URL=redis://127.0.0.1:6379

# OTP codes are returned in issuance endpoint responses
OTP_HMAC_SECRET=replace_with_at_least_32_random_characters
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
